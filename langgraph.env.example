# Copy to langgraph.env and fill in. Git-ignored.
# Groq speaks the common chat-completions format.
LLM_BASE_URL=https://api.groq.com/openai/v1
# A model name from Groq's current list (https://console.groq.com/docs/models) that supports tool calling
LLM_MODEL=CHOOSE_A_MODEL_FROM_GROQS_LIST
LLM_API_KEY=YOUR_GROQ_API_KEY
