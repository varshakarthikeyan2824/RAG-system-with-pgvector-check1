# Copy to app.env and fill in. app.env is git-ignored. Never commit it.
# Host "db" is the Postgres container. The password must match postgres.env.
DATABASE_URL=postgresql://water_user:CHANGE_ME_HEX_PASSWORD@db:5432/water_rag_db
GROQ_API_KEY=YOUR_GROQ_API_KEY
APP_ENV=production
# Production needs random values of at least 32 characters:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=replace-with-a-random-secret
SERVICE_API_KEY=replace-with-a-long-random-value
CORS_ALLOWED_ORIGINS=
# Ollama runs on the host machine
OLLAMA_EMBED_URL=http://host.docker.internal:11434/api/embed
