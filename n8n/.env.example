# Copy to .env and fill in:   cp .env.example .env && chmod 600 .env
# .env must NEVER be committed to Git (add it to .gitignore). Only this example file goes in Git.

# A time zone name from the tz database, for example Etc/UTC, Europe/London or Asia/Kolkata.
TIMEZONE=Etc/UTC

POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Make one:  openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
POSTGRES_PASSWORD=<generate-a-password>

# Make one:  openssl rand -hex 32
# BACK THIS UP in a password manager before you start n8n. If you lose it, every credential
# saved in n8n becomes unreadable. Do not change it after the first start.
N8N_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
